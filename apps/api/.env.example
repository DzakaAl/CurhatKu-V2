CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

# Default dev: SQLite (tanpa setup). Untuk MySQL, komentari 2 baris SQLite
# lalu aktifkan blok MySQL dan isi password.
database.default.DBDriver = SQLite3
database.default.database = curhatku.db

# database.default.DBDriver = MySQLi
# database.default.hostname = localhost
# database.default.database = curhatku
# database.default.username = root
# database.default.password = ISI_PASSWORD
# database.default.port = 3306

# Ganti dengan string acak panjang di produksi
jwt.secret = 'GANTI_DENGAN_STRING_ACAK'
jwt.accessTtl = 900
jwt.refreshTtl = 2592000
cookie.secure = false

cors.allowedOrigins = 'http://localhost:3000'
frontend.url = 'http://localhost:3000'
